 * @see /assets/js/banner.js    — Hero banner rendering module.
 * @see /assets/js/home.js      — Home page route renderer.
 * @see /assets/js/browse.js    — Browse page route renderer.
 * @see /assets/js/router.js    — Client-side SPA router with History API integration.
