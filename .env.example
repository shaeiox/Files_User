# Every value below is checked at startup; check a file with: node server.js --check-config
PORT=4000
# The files served. With the admin integration on, the admin's storage or ANY folder
# in it, mounted at any path: the portal finds which admin folder it is from the
# storage's .dimension-volume marker (logged at startup); nothing has to match.
FILES_ROOT=
# Release folder (legacy mode, or an admin older than schema v5). With a v5 admin
# the release folder is set in Admin > File portal and this is ignored.
RELEASE_PVM=
# Base of the default data files (users.json, portal.log). Default <project>/data.
# NODE_ENV=production requires it, refuses every relative path variable, and
# refuses state inside this project folder or a FILES_ROOT that overlaps either.
# PORTAL_DATA_DIR=
# NODE_ENV=production
# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION GATE — Protects RELEASE_PVM access (legacy mode).
# With ADMIN_INTEGRATION_ENABLED=true, release protection is the lock on the
# release folder in the Admin Files Manager instead of this file, and a v5
# admin's session/throttle values (Admin > File portal) override the three below.
# ═══════════════════════════════════════════════════════════════
AUTH_ENABLED=true
AUTH_SESSION_MINUTES=30
# Required with AUTH_ENABLED=true: 32+ characters, or startup is refused. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=
# Default <PORTAL_DATA_DIR>/users.json.
# AUTH_USERS_FILE=
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# ═══════════════════════════════════════════════════════════════
# ADMIN INTEGRATION — read-only link to Dimension Files Manager
# ═══════════════════════════════════════════════════════════════
# Leave all unset to run standalone (all content public, current behaviour).
# Anything partial is a configuration error and the server refuses to start, so
# a governed file can never silently become public.
#
# To enable (isolate-app-roots: a URL and a token, no shared folders):
#   1. Set ADMIN_INTEGRATION_ENABLED=true and AUTH_ENABLED=true.
#   2. Set ADMIN_API_URL to the admin's origin (https unless on this host) and
#      ADMIN_SERVICE_TOKEN to the admin's AFM_PORTAL_SERVICE_TOKEN (32+ chars).
#      Startup fetches one snapshot and refuses if it fails.
#   Deprecated alternative, removed next release: ADMIN_DB_PATH (the admin
#   database, read-only) instead of ADMIN_API_URL - never both.
#   FILES_ROOT may be the admin's STORAGE_ROOT or any folder in it; portal path
#   a/b is admin client path <that folder>/a/b, so every policy applies as in the
#   admin. A host that sees only a folder needs it published in Admin > File portal.
# ADMIN_INTEGRATION_ENABLED=false
# ADMIN_API_URL=
# ADMIN_SERVICE_TOKEN=
# ADMIN_DB_PATH=
# FILES_ROOT may be ANY folder on this host. Its admin folder is: a storage
# marker found at or above it (verified); else this value; else the Portal folder
# published in Admin > File portal; else "/". A mapped (unverified) folder is
# logged at startup. Policies apply by path: <folder>/a/b governs FILES_ROOT/a/b.
# FILES_ROOT_ADMIN_PATH=/
# How often admin changes (users, policies, grants, settings) are re-read, in ms.
# Default 5000, clamped to 1000-60000.
# ADMIN_SYNC_TTL_MS=5000
# Trace log (JSON lines). The Admin Files Manager's Logs pane reads it through
# GET /api/ops/log (needs ADMIN_SERVICE_TOKEN). Default <PORTAL_DATA_DIR>/portal.log;
# 'off' disables it.
# LOG_FILE=
# Accept curl -u (HTTP Basic) over plain HTTP from other hosts. Off by default:
# without TLS the password crosses the network in clear text.
# AUTH_BASIC_ALLOW_HTTP=false
# ═══════════════════════════════════════════════════════════════
# HTTP HARDENING
# ═══════════════════════════════════════════════════════════════
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers may be
# trusted. Any other peer's forwarded headers are ignored, so a client cannot
# spoof its IP (rate limiting, logs) or claim HTTPS. Default 127.0.0.1,::1.
# TRUSTED_PROXIES=127.0.0.1,::1
# Browser origins allowed to call the API cross-origin (CSV). Empty = same-origin
# only (no CORS headers). Prefer leaving it empty when served behind nginx:
# with credentials, never '*' and never '*' alongside Access-Control-Allow-Credentials.
# CORS_ALLOWED_ORIGINS=
# In-memory rate limiter / brute-force tracker ceilings (per process).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_MAX_IPS=10000
# AUTH_MAX_FAILED_ENTRIES=5000
# Forget a username's failed-attempt counter after this idle time (ms). Default 24 h.
# AUTH_FAILED_IDLE_MS=86400000
# Largest file /api/hash will checksum (bytes). Default 512 MiB.
# HASH_MAX_BYTES=536870912
# Full production templates and every variable: docs/DEPLOYMENT.md §5.

# Directory cache for home-page counts and search (ms; 0 disables). Access decisions are never cached.
# CONTENT_INDEX_TTL_MS=30000
# CONTENT_INDEX_MAX_DIRS=20000
