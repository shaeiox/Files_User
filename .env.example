# HTTP port for the Node.js server
PORT=3000

# Root directory of downloadable resources (Windows or Linux).
# Relative paths are resolved from the project root (this repository).
# Do not point this at the application source tree.
#
# Linux example:
# FILES_ROOT=/srv/cloudavid/downloads
#
# Windows example:
# FILES_ROOT=D:\CloudAvid\Downloads
#
FILES_ROOT=./sample-downloads
