PORT=4000
# The files served. With the admin integration on, the admin's storage or ANY folder
# in it, mounted at any path: the portal finds which admin folder it is from the
# storage's .dimension-volume marker (logged at startup); nothing has to match.
FILES_ROOT=
# Release folder (legacy mode, or an admin older than schema v5). With a v5 admin
# the release folder is set in Admin > File portal and this is ignored.
RELEASE_PVM=
# Base of the default data files (users.json, portal.log). Default <project>/data.
# NODE_ENV=production requires it and refuses every relative path variable.
# PORTAL_DATA_DIR=
# NODE_ENV=production
# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION GATE — Protects RELEASE_PVM access (legacy mode).
# With ADMIN_INTEGRATION_ENABLED=true, release protection is the lock on the
# release folder in the Admin Files Manager instead of this file, and a v5
# admin's session/throttle values (Admin > File portal) override the three below.
# ═══════════════════════════════════════════════════════════════
AUTH_ENABLED=true
AUTH_SESSION_MINUTES=1
AUTH_JWT_SECRET=
# Default <PORTAL_DATA_DIR>/users.json.
# AUTH_USERS_FILE=
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# ═══════════════════════════════════════════════════════════════
# ADMIN INTEGRATION — read-only link to Dimension Files Manager
# ═══════════════════════════════════════════════════════════════
# Leave BOTH unset to run standalone (all content public, current behaviour).
# Setting only one of them is a configuration error and the server will refuse
# to start, so a governed file can never silently become public.
#
# To enable:
#   1. Set ADMIN_INTEGRATION_ENABLED=true and AUTH_ENABLED=true.
#   2. Point ADMIN_DB_PATH at the admin database (read-only).
#   FILES_ROOT may be the admin's STORAGE_ROOT or any folder in it; portal path
#   a/b is admin client path <that folder>/a/b, so every policy applies as in the
#   admin. A host that sees only a folder needs it published in Admin > File portal.
# ADMIN_INTEGRATION_ENABLED=false
# ADMIN_DB_PATH=
# How often admin changes (users, policies, grants, settings) are re-read, in ms.
# Default 5000, clamped to 1000-60000.
# ADMIN_SYNC_TTL_MS=5000
# Trace log (JSON lines) read by the Admin Files Manager's Logs pane (its
# PORTAL_LOG_FILE must name this same file). Default <PORTAL_DATA_DIR>/portal.log;
# 'off' disables it.
# LOG_FILE=
# Accept curl -u (HTTP Basic) over plain HTTP from other hosts. Off by default:
# without TLS the password crosses the network in clear text.
# AUTH_BASIC_ALLOW_HTTP=false
# ═══════════════════════════════════════════════════════════════
# HTTP HARDENING
# ═══════════════════════════════════════════════════════════════
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers may be
# trusted. Any other peer's forwarded headers are ignored, so a client cannot
# spoof its IP (rate limiting, logs) or claim HTTPS. Default 127.0.0.1,::1.
# TRUSTED_PROXIES=127.0.0.1,::1
# Browser origins allowed to call the API cross-origin (CSV). Empty = same-origin
# only (no CORS headers). Prefer leaving it empty when served behind nginx:
# with credentials, never '*' and never '*' alongside Access-Control-Allow-Credentials.
# CORS_ALLOWED_ORIGINS=
# In-memory rate limiter / brute-force tracker ceilings (per process).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_MAX_IPS=10000
# AUTH_MAX_FAILED_ENTRIES=5000
